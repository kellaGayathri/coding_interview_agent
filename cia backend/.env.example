APP_NAME=Coding Interview Agent Backend

# CORS - comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=https://your-frontend.vercel.app

# PostgreSQL (Render provides this automatically via render.yaml)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Judge0
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=your-rapidapi-key
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
JUDGE0_POLL_INTERVAL_SECONDS=1.0
JUDGE0_MAX_POLL_ATTEMPTS=10

# Hugging Face
HUGGINGFACE_API_TOKEN=hf_your_token_here
REPO_ID=Qwen/Qwen3-Coder-Next
HF_API_BASE_URL=https://api-inference.huggingface.co
HF_MAX_NEW_TOKENS=1024
HF_TEMPERATURE=0.6
HF_TIMEOUT_SECONDS=120
